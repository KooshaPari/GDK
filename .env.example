# OTLP endpoint for distributed tracing export (ADR-012, ADR-036)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Service name (used as OpenTelemetry resource attribute)
OTEL_SERVICE_NAME=gdk
# Resource attributes (comma-separated key=value)
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev,service.namespace=phenotype
